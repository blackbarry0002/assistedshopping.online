# Copy to .env.local for local development, and set the same variables in
# your hosting provider's production environment.

# Allow search engines to index the site. Set to "true" ONLY on the
# production deployment at https://assistedshopping.online. Leave unset on
# previews/staging so they are excluded from search results.
NEXT_PUBLIC_ALLOW_INDEXING=

# Endpoint for the secondary service-request form on /contact
# (e.g. a Formspree/Basin form URL, CRM webhook, or your own API route).
# Leave empty to keep the form in clearly-labelled prototype mode.
NEXT_PUBLIC_FORM_ENDPOINT=
